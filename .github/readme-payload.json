      "text": "<svg xmlns=\"http://www.w3.org/2000/svg\" width=\"1040\" height=\"640\" viewBox=\"0 0 1040 640\" role=\"img\" aria-labelledby=\"title desc\">\n  <title id=\"title\">Mi Step \u5de5\u4f5c\u533a\u5e03\u5c40\u4e0e\u4e09\u6b65\u64cd\u4f5c</title>\n  <desc id=\"desc\">\u9876\u90e8\u4e3a\u63a7\u5236\u4e2d\u5fc3\u3001\u97f3\u4e50\u4e0e\u5de5\u5177\u680f\u3002\u4e0b\u65b9\u4e3a\u4e00\u4e2a\u4e3b\u533a\u57df\u548c\u4e09\u4e2a\u526f\u4efb\u52a1\u683c\u3002\u5148\u6253\u5f00\u5e94\u7528\uff0c\u518d\u70b9\u51fb\u7a7a\u683c\u6536\u7eb3\uff1b\u70b9\u51fb\u5df2\u6709\u526f\u4efb\u52a1\u4ea4\u6362\uff1b\u5411\u5916\u6ed1\u51fa\u5c06\u4efb\u52a1\u4ea4\u56de\u7cfb\u7edf\u540e\u53f0\u3002</desc>\n  <defs>\n    <linearGradient id=\"page\" x1=\"0\" y1=\"0\" x2=\"1\" y2=\"1\">\n      <stop offset=\"0\" stop-color=\"#eff8f2\"/><stop offset=\"1\" stop-color=\"#f8faf9\"/>\n    </linearGradient>\n    <linearGradient id=\"green\" x1=\"0\" y1=\"0\" x2=\"1\" y2=\"1\">\n      <stop offset=\"0\" stop-color=\"#245c48\"/><stop offset=\"1\" stop-color=\"#183e33\"/>\n    </linearGradient>\n    <marker id=\"arrow\" markerWidth=\"7\" markerHeight=\"7\" refX=\"5\" refY=\"3.5\" orient=\"auto-start-reverse\"><path d=\"M0 0L6 3.5L0 7\" fill=\"none\" stroke=\"#369368\" stroke-width=\"1.5\"/></marker>\n  </defs>\n  <rect x=\"1\" y=\"1\" width=\"1038\" height=\"638\" rx=\"28\" fill=\"url(#page)\" stroke=\"#d9e7df\"/>\n  <g font-family=\"-apple-system,BlinkMacSystemFont,Segoe UI,Microsoft YaHei,Noto Sans CJK SC,sans-serif\">\n    <rect x=\"42\" y=\"29\" width=\"442\" height=\"580\" rx=\"32\" fill=\"#dce8e1\"/>\n    <rect x=\"48\" y=\"23\" width=\"430\" height=\"580\" rx=\"30\" fill=\"#fff\" stroke=\"#b8cbc0\" stroke-width=\"2\"/>\n    <rect x=\"62\" y=\"39\" width=\"402\" height=\"113\" rx=\"18\" fill=\"url(#green)\"/>\n    <circle cx=\"90\" cy=\"67\" r=\"8\" fill=\"#91d6ad\"/>\n    <circle cx=\"113\" cy=\"67\" r=\"8\" fill=\"#5b9d79\"/>\n    <circle cx=\"136\" cy=\"67\" r=\"8\" fill=\"#5b9d79\"/>\n    <rect x=\"352\" y=\"54\" width=\"42\" height=\"70\" rx=\"17\" fill=\"#ffffff\" fill-opacity=\".18\"/>\n    <rect x=\"405\" y=\"54\" width=\"42\" height=\"70\" rx=\"17\" fill=\"#ffffff\" fill-opacity=\".30\"/>\n    <text x=\"82\" y=\"104\" fill=\"#fff\" font-size=\"20\" font-weight=\"600\">\u63a7\u5236\u4e2d\u5fc3 / \u539f\u751f\u97f3\u4e50</text>\n    <text x=\"82\" y=\"129\" fill=\"#bfdfcf\" font-size=\"13\">\u5de6\u53f3\u6ed1\u52a8\u5207\u6362\u9762\u677f</text>\n    <rect x=\"62\" y=\"162\" width=\"402\" height=\"40\" rx=\"12\" fill=\"#eef3ef\"/>\n    <text x=\"263\" y=\"188\" text-anchor=\"middle\" fill=\"#546d5e\" font-size=\"15\">\u5de5\u5177\u680f \u00b7 \u5e38\u7528\u5e94\u7528</text>\n    <rect x=\"62\" y=\"214\" width=\"284\" height=\"372\" rx=\"16\" fill=\"#f9fbfa\" stroke=\"#c8d9ce\"/>\n    <rect x=\"78\" y=\"231\" width=\"252\" height=\"8\" rx=\"4\" fill=\"#dce7e0\"/>\n    <rect x=\"78\" y=\"250\" width=\"172\" height=\"7\" rx=\"3.5\" fill=\"#e6ede8\"/>\n    <text x=\"204\" y=\"361\" text-anchor=\"middle\" fill=\"#244e38\" font-size=\"30\" font-weight=\"650\">\u4e3b\u533a\u57df</text>\n    <text x=\"204\" y=\"393\" text-anchor=\"middle\" fill=\"#6b8072\" font-size=\"15\">\u70b9\u6309 \u00b7 \u6eda\u52a8 \u00b7 \u8f93\u5165</text>\n    <rect x=\"91\" y=\"485\" width=\"226\" height=\"72\" rx=\"10\" fill=\"#e7eee9\"/>\n    <g fill=\"#f9fbfa\">\n      <rect x=\"103\" y=\"497\" width=\"202\" height=\"10\" rx=\"3\"/>\n      <rect x=\"112\" y=\"515\" width=\"184\" height=\"10\" rx=\"3\"/>\n      <rect x=\"153\" y=\"533\" width=\"102\" height=\"10\" rx=\"3\"/>\n    </g>\n    <rect x=\"358\" y=\"214\" width=\"106\" height=\"116\" rx=\"14\" fill=\"#dcefe2\"/>\n    <text x=\"411\" y=\"266\" text-anchor=\"middle\" fill=\"#24523a\" font-size=\"17\" font-weight=\"600\">\u526f\u4efb\u52a1 1</text>\n    <text x=\"411\" y=\"293\" text-anchor=\"middle\" fill=\"#5b7b66\" font-size=\"13\">\u70b9\u6309\u4ea4\u6362</text>\n    <rect x=\"358\" y=\"342\" width=\"106\" height=\"116\" rx=\"14\" fill=\"#e4eee7\"/>\n    <text x=\"411\" y=\"394\" text-anchor=\"middle\" fill=\"#24523a\" font-size=\"17\" font-weight=\"600\">\u526f\u4efb\u52a1 2</text>\n    <text x=\"411\" y=\"421\" text-anchor=\"middle\" fill=\"#5b7b66\" font-size=\"13\">\u5411\u5916\u6ed1\u51fa</text>\n    <rect x=\"358\" y=\"470\" width=\"106\" height=\"116\" rx=\"14\" fill=\"#f0f5f1\" stroke=\"#b8d0bf\" stroke-dasharray=\"5 5\"/>\n    <path d=\"M399 513H423M411 501V525\" stroke=\"#75a587\" stroke-width=\"2.5\" stroke-linecap=\"round\"/>\n    <text x=\"411\" y=\"552\" text-anchor=\"middle\" fill=\"#5b7b66\" font-size=\"13\">\u6536\u7eb3\u5f53\u524d\u5e94\u7528</text>\n    <path d=\"M333 309H370\" fill=\"none\" stroke=\"#369368\" stroke-width=\"2\" marker-start=\"url(#arrow)\" marker-end=\"url(#arrow)\"/>\n    <text x=\"539\" y=\"94\" fill=\"#214d36\" font-size=\"30\" font-weight=\"700\">\u628a\u5e94\u7528\u7559\u5728\u773c\u524d</text>\n    <text x=\"540\" y=\"126\" fill=\"#708577\" font-size=\"16\">\u4e00\u4e3b\u4e09\u526f\uff0c\u5404\u6709\u4f4d\u7f6e\uff0c\u968f\u624b\u4ea4\u6362\u3002</text>\n    <g>\n      <circle cx=\"558\" cy=\"199\" r=\"19\" fill=\"#d6eadc\"/>\n      <text x=\"558\" y=\"205\" text-anchor=\"middle\" fill=\"#2a6544\" font-size=\"18\" font-weight=\"700\">1</text>\n      <text x=\"595\" y=\"198\" fill=\"#254b35\" font-size=\"21\" font-weight=\"650\">\u5148\u6253\u5f00\uff0c\u518d\u6536\u7eb3</text>\n      <text x=\"595\" y=\"228\" fill=\"#697e70\" font-size=\"16\">\u4e3b\u533a\u57df\u6253\u5f00\u5e94\u7528 \u2192 \u70b9\u7a7a\u683c\u300c\uff0b\u300d</text>\n    </g>\n    <g>\n      <circle cx=\"558\" cy=\"307\" r=\"19\" fill=\"#d6eadc\"/>\n      <text x=\"558\" y=\"313\" text-anchor=\"middle\" fill=\"#2a6544\" font-size=\"18\" font-weight=\"700\">2</text>\n      <text x=\"595\" y=\"306\" fill=\"#254b35\" font-size=\"21\" font-weight=\"650\">\u70b9\u8c01\uff0c\u5c31\u64cd\u4f5c\u8c01</text>\n      <text x=\"595\" y=\"336\" fill=\"#697e70\" font-size=\"16\">\u70b9\u51fb\u5df2\u6709\u526f\u4efb\u52a1\uff0c\u4e0e\u4e3b\u533a\u57df\u4ea4\u6362</text>\n    </g>\n    <g>\n      <circle cx=\"558\" cy=\"415\" r=\"19\" fill=\"#d6eadc\"/>\n      <text x=\"558\" y=\"421\" text-anchor=\"middle\" fill=\"#2a6544\" font-size=\"18\" font-weight=\"700\">3</text>\n      <text x=\"595\" y=\"414\" fill=\"#254b35\" font-size=\"21\" font-weight=\"650\">\u5411\u5916\u6ed1\u51fa\uff0c\u817e\u51fa\u4f4d\u7f6e</text>\n      <text x=\"595\" y=\"444\" fill=\"#697e70\" font-size=\"16\">\u4efb\u52a1\u4ea4\u56de\u7cfb\u7edf\u540e\u53f0\uff0c\u7a7a\u683c\u53ef\u4ee5\u518d\u6536\u7eb3</text>\n    </g>\n    <path d=\"M540 492H970\" stroke=\"#d1e0d5\"/>\n    <text x=\"540\" y=\"531\" fill=\"#688371\" font-size=\"15\">\u5b8c\u6574\u8f93\u5165\u96c6\u4e2d\u5728\u4e3b\u533a\u57df</text>\n    <text x=\"540\" y=\"556\" fill=\"#8a9e90\" font-size=\"13\">\u5e03\u5c40\u793a\u610f \u00b7 \u53ef\u9009\u62e9\u5de6\u4fa7\u6216\u53f3\u4fa7\u526f\u4efb\u52a1\u533a</text>\n  </g>\n</svg>\n"
    }
  ]
}
